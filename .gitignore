# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.pdb
*.so

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
.env.bak

# ── Environment / secrets ─────────────────────────────────────────────────────
.env
# keep .env.example in version control

# ── Build / packaging ─────────────────────────────────────────────────────────
*.egg-info/
dist/
build/
*.whl
*.egg
MANIFEST

# ── Database files ────────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
data/*.db
data/*.sqlite
# WAL / SHM files (SQLite write-ahead log – Windows lock artefacts)
*.db-wal
*.db-shm

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Test result artefacts (keep directory, ignore generated files) ────────────
test_results/*.json
test_results/*.csv
test_results/*.md
# but keep the README
!test_results/README.md

# ── OS artefacts ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE / editor ──────────────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo

# ── Docker ────────────────────────────────────────────────────────────────────
# (Dockerfile and docker-compose.yml are intentionally tracked)

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Coverage / profiling ──────────────────────────────────────────────────────
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
